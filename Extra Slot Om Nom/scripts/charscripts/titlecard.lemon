function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
    // Title card red bar
    if (objA0.update_address == 0x02d8e2 && global.xtrachar == 248)
    {
        Renderer.drawCustomSprite("omnom_card", px - 0x20, py - 0x40, 0x00, SPRITE_FLAG_PRIO | SPRITE_FLAG_NO_GLOBAL_TINT, renderQueue)
        return true
    }
    
    return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}